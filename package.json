{
  "name": "gamification-loyalty-engine",
  "version": "1.0.0",
  "description": "A central gamification & loyalty engine that any app can integrate",
  "private": true,
  "workspaces": [
    "backend",
    "admin"
  ],
  "scripts": {
    "dev": "npm run docker:up && npm run dev:backend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:admin": "npm run dev --workspace=admin",
    "build": "npm run build:backend && npm run build:admin",
    "build:backend": "npm run build --workspace=backend",
    "build:admin": "npm run build --workspace=admin",
    "start": "npm run start --workspace=backend",
    "test": "npm run test --workspace=backend",
    "test:watch": "npm run test:watch --workspace=backend",
    "lint": "npm run lint --workspace=backend && npm run lint --workspace=admin",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:reset": "npm run db:reset --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "prisma:studio": "npm run prisma:studio --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend"
  },
  "keywords": [
    "gamification",
    "loyalty",
    "points",
    "badges",
    "levels"
  ],
  "author": "",
  "license": "MIT"
}
